#!/usr/bin/env bash
#
# Pre-commit: keep the owner's body metrics out of a public repository.
#
# Enabled by `git config core.hooksPath .githooks`, which package.json's
# `prepare` script runs on npm install. Versioned rather than living in
# .git/hooks so it is reviewable and arrives with a clone.
#
# --tree-only on purpose, and the reason has changed since this was written.
#
# The original reason was that history still carried real figures from before
# FUEL-14. That is no longer true: the rewrite landed on 2026-08-19 and the
# history check is green. What is still true is the general form of the
# argument — a commit can only be held responsible for what it can actually
# fix, and it can fix neither history nor the host.
#
# The full check now also contacts the remote (check 3, published refs), which
# on this repository fails: GitHub's refs/pull/* still serve the pre-rewrite
# values, knowingly. Gating commits on a network call that always fails would
# block every commit, everyone would learn to pass --no-verify, and the hook
# would be worth nothing on the day it finally mattered.
#
# So the hook keeps its narrow job: stop a real figure entering the working
# tree. Run the full scan before publishing:  npm run check:metrics
#
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

if [ ! -x "$repo_root/scripts/check-no-metrics.sh" ]; then
  printf 'pre-commit: scripts/check-no-metrics.sh is missing or not executable\n' >&2
  exit 1
fi

if ! "$repo_root/scripts/check-no-metrics.sh" --tree-only; then
  printf '\npre-commit: blocked. Fix the findings above, or if the figure is\n' >&2
  printf 'fictional add it to an ALLOW_* list in scripts/check-no-metrics.sh.\n' >&2
  printf 'Override only if you are certain: git commit --no-verify\n' >&2
  exit 1
fi
