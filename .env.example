# Copy to .env.local and fill in. .env.local is gitignored — this repository is
# public, so a real connection string must never be committed.
#
# The three connection strings come from the Neon console: Project → Connect.
# See README → Database. The two auth secrets below you generate yourself.
#
# Define EVERY variable here in Vercel as well, not only locally. `vercel env
# pull` OVERWRITES .env.local with what Vercel knows about, so a secret that
# only ever existed on this machine disappears the next time anyone runs it —
# and the failure arrives later, as a missing variable, far from the cause.

# Pooled connection string — the host contains "-pooler".
# Used by the app at runtime (both src/lib/db/index.ts and pool.ts).
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection string — same host WITHOUT "-pooler".
# Used by drizzle-kit only: DDL needs a session, not a transaction pooler.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Connection string for the "test" Neon branch — a SEPARATE database.
# Used by tests/integration only, which truncates tables. Pointing this at the
# same host as DATABASE_URL is refused by the test harness.
DATABASE_URL_TEST="postgresql://user:password@ep-example-654321-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# The owner's password — the whole of the login gate. One human uses this app,
# so there is no user table to hash into: the secret lives here and is compared
# server-side. Never prefixed NEXT_PUBLIC_, so it cannot reach the browser.
OWNER_PASSWORD="choose-something-long-and-unguessable"

# Signs the session cookies. Generate with:
#
#     openssl rand -base64 32
#
# Rotating it invalidates every live session, owner and demo alike — which is
# also how you revoke one.
SESSION_SECRET="generate-your-own-do-not-use-this-value"

# Proves that a request to /api/cron/reap-demos came from Vercel's scheduler and
# not from someone who read vercel.json in this public repository. Vercel sends
# it as `Authorization: Bearer $CRON_SECRET` once the variable is set on the
# project. Generate it the same way:
#
#     openssl rand -base64 32
#
# Required in production: the route THROWS when it is absent rather than
# answering 401, so that a job which has never once run cannot be mistaken for a
# job being probed. Locally it is only needed to call the route by hand.
CRON_SECRET="generate-your-own-do-not-use-this-value"

# --- Web push (FUEL-47, § P9) ---
#
# All three are OPTIONAL, unlike everything above. Absent, the settings control
# is hidden and the scheduled job logs and exits 200. P9 asks that push "degrade
# silently to the banner", so a deployment with no keys is a supported state
# rather than a broken one — which is why lib/env.ts returns null for these
# instead of throwing the way it does for every other variable here.
#
# Generate a pair with:
#
#     npx web-push generate-vapid-keys
#
# The PUBLIC key is deliberately NEXT_PUBLIC_. The browser sends it to the push
# service as the application server key, so it reaches the client by design and
# is safe in a public repository. Changing it invalidates every existing
# subscription: a browser's subscription is bound to the key it was created
# with, and the old ones then fail 403 until each device re-subscribes.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BExampleReplaceMeWithYourOwnPublicKey"

# Signs the JWT that proves a push request came from this deployment. The one
# secret in this feature. Never prefixed NEXT_PUBLIC_.
VAPID_PRIVATE_KEY="generate-your-own-do-not-use-this-value"

# Who a push service should contact about this application server. RFC 8292
# allows a mailto: or an https: URI, and the deployment's own URL is used here
# rather than a personal address, which would otherwise be sent to Google,
# Mozilla and Apple with every notification.
VAPID_SUBJECT="https://fuel-and-form.vercel.app"
